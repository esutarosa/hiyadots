if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

for f in \
  /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme \
  $HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme; do
  [[ -r $f ]] && source $f && break
done

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
elif (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

[ -f "$HOME/.config/fzf/hiyashinsu-moondust" ] && export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/hiyashinsu-moondust"

zi() {
  cd "$(zoxide query -l | fzf)"
}
alias zf='zi'

nls() {
  local target="${1:-.}"

  target="${target//\\/\\\\}"
  target="${target//\"/\\\"}"

  nu -c "ls \"$target\" | table -e"
}

alias c='clear'
alias n='nvim'
alias t='tmux'
if (( $+commands[eza] )); then
  alias l='eza -lh --icons=auto'
  alias ls='eza -1 --icons=auto'
  alias ll='eza -lha --icons=auto --sort=name --group-directories-first'
  alias ld='eza -lhD --icons=auto'
  alias lt='eza --icons=auto --tree'
fi

if (( $+commands[brew] )); then
  alias un='brew uninstall'
  alias up='brew update && brew upgrade'
  alias pl='brew list'
  alias pa='brew search'
  alias pc='brew cleanup'
  alias po='brew outdated'
elif (( $+commands[apt-get] )); then
  (( EUID == 0 )) || sudo_cmd=sudo
  alias un="$sudo_cmd apt remove"
  alias up="$sudo_cmd apt update && $sudo_cmd apt upgrade"
  alias pl='apt list --installed'
  alias pa='apt search'
  alias pc="$sudo_cmd apt autoremove && $sudo_cmd apt clean"
  alias po='apt list --upgradable'
elif (( $+commands[pacman] )); then
  (( EUID == 0 )) || sudo_cmd=sudo
  alias un="$sudo_cmd pacman -Rns"
  alias up="$sudo_cmd pacman -Syu"
  alias pl='pacman -Q'
  alias pa='pacman -Ss'
  alias pc="$sudo_cmd pacman -Sc"
  alias po='pacman -Qu'
fi
unset sudo_cmd

alias ..='cd ..'
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'
alias d3='cd ../../..'
alias d4='cd ../../../..'
alias d5='cd ../../../../..'

(( $+commands[zoxide] )) && alias cd='z'

alias mkdir='mkdir -p'

alias gc='git commit -m'
alias gca='git commit -a -m'
alias gp='git push origin HEAD'
alias gpu='git pull origin'
alias gst='git status'
alias glog='git log --graph --topo-order --pretty='\''%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N'\'' --abbrev-commit'
alias gdiff='git diff'
alias gco='git checkout'
alias gb='git branch'
alias gba='git branch -a'
alias gadd='git add'
alias ga='git add -p'
alias gcoall='git checkout -- .'
alias gr='git remote'
alias gre='git reset'
alias k='kubectl'
alias ka='kubectl apply -f'
alias kg='kubectl get'
alias kd='kubectl describe'
alias kdel='kubectl delete'
alias kl='kubectl logs -f'
alias kgpo='kubectl get pod'
alias kgd='kubectl get deployments'
alias kc='kubectx'
alias kns='kubens'
alias ke='kubectl exec -it'

HISTFILE=$HOME/.history
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

for f in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [[ -r $f ]] && source $f && break
done
for f in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r $f ]] && source $f && break
done

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

unset f
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$GOBIN:$PATH"

export PATH="$HOME/.local/bin:$PATH"

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi
