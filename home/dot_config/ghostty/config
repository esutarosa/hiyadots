theme = hiyashinsu-moondust
background-opacity = 0.8
background-blur-radius = 20

font-family = "PlemolJP Console NF"

cursor-style = block
cursor-style-blink = true

macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

keybind = ctrl+t>ctrl+t=text:\x14
keybind = ctrl+t>r=reload_config
keybind = ctrl+t>c=new_tab
keybind = ctrl+t>n=next_tab
keybind = ctrl+t>p=previous_tab
keybind = ctrl+t>1=goto_tab:1
keybind = ctrl+t>2=goto_tab:2
keybind = ctrl+t>3=goto_tab:3
keybind = ctrl+t>4=goto_tab:4
keybind = ctrl+t>5=goto_tab:5
keybind = ctrl+t>6=goto_tab:6
keybind = ctrl+t>7=goto_tab:7
keybind = ctrl+t>8=goto_tab:8
keybind = ctrl+t>9=goto_tab:9
keybind = ctrl+t>,=prompt_tab_title
keybind = ctrl+t>shift+7=close_tab
keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:1

keybind = ctrl+t>shift+5=new_split:right
keybind = ctrl+t>shift+apostrophe=new_split:down
keybind = ctrl+t>shift+backslash=new_split:right
keybind = ctrl+t>minus=new_split:down
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>j=goto_split:down
keybind = ctrl+t>k=goto_split:up
keybind = ctrl+t>l=goto_split:right
keybind = ctrl+t>left=goto_split:left
keybind = ctrl+t>down=goto_split:down
keybind = ctrl+t>up=goto_split:up
keybind = ctrl+t>right=goto_split:right
keybind = ctrl+t>shift+h=resize_split:left,50
keybind = ctrl+t>shift+j=resize_split:down,50
keybind = ctrl+t>shift+k=resize_split:up,50
keybind = ctrl+t>shift+l=resize_split:right,50
keybind = ctrl+t>z=toggle_split_zoom
keybind = ctrl+t>space=equalize_splits
keybind = ctrl+t>x=close_surface

keybind = cmd+j=text:\x1bj
keybind = cmd+k=text:\x1bk
