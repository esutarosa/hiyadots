#!/bin/sh
{{- $selected := list -}}
{{- range .picks -}}{{- $selected = concat $selected . -}}{{- end -}}
{{- $lists := dict -}}
{{- range $key := list "pkg" "brew" "cask" "pacman" "apt" "aur" "nix" -}}
{{-   $names := list -}}
{{-   range $name := $selected -}}
{{-     $tool := index $.tools $name -}}
{{-     if and $tool (hasKey $tool $key) -}}{{- $names = concat $names (index $tool $key) -}}{{- end -}}
{{-   end -}}
{{-   $_ := set $lists $key ($names | uniq | join " ") -}}
{{- end }}
pkg="{{ $lists.pkg }}"
brew="{{ $lists.brew }}"
cask="{{ $lists.cask }}"
pacman="{{ $lists.pacman }}"
apt="{{ $lists.apt }}"
aur="{{ $lists.aur }}"
nix="{{ $lists.nix }}"

failed=""
sudo=""
[ "$(id -u)" -eq 0 ] || sudo=sudo
install() { # install <package> <command...>
  package=$1; shift
  "$@" "$package" || failed="$failed $package"
}

install_alacritty() { # Homebrew disabled the cask, so this takes the upstream build
  [ -d /Applications/Alacritty.app ] && return 0
  tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/alacritty/alacritty/releases/latest) || return 1
  tag=${tag##*/}
  work=$(mktemp -d)
  status=1
  if curl -fsSL -o "$work/alacritty.dmg" "https://github.com/alacritty/alacritty/releases/download/$tag/Alacritty-$tag.dmg" &&
    hdiutil attach -quiet -nobrowse -readonly -mountpoint "$work/mnt" "$work/alacritty.dmg"; then
    cp -R "$work/mnt/Alacritty.app" /Applications/
    status=$?
    hdiutil detach -quiet "$work/mnt"
  fi
  rm -rf "$work"
  return $status
}

if [ "$(uname)" = Darwin ]; then
  if ! command -v brew >/dev/null && [ ! -x /opt/homebrew/bin/brew ]; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"
  for p in $pkg $brew; do
    brew list --formula "${p##*/}" >/dev/null 2>&1 || install "$p" brew install --formula
  done
  for p in $cask; do
    brew list --cask "$p" >/dev/null 2>&1 && continue
    if [ "$p" = alacritty ]; then
      install_alacritty || failed="$failed alacritty"
    else
      install "$p" brew install --cask
    fi
  done
elif command -v pacman >/dev/null; then
  [ -e /var/lib/pacman/sync/core.db ] || $sudo pacman -Sy
  for p in $pkg $pacman; do install "$p" $sudo pacman -S --needed --noconfirm; done
  if [ -n "$aur" ] && ! command -v paru >/dev/null; then
    $sudo pacman -S --needed --noconfirm base-devel git
    build=$(mktemp -d)
    git clone https://aur.archlinux.org/paru-bin.git "$build" && (cd "$build" && makepkg -si --noconfirm)
    rm -rf "$build"
  fi
  if command -v paru >/dev/null; then
    for p in $aur; do install "$p" paru -S --needed --noconfirm; done
  elif [ -n "$aur" ]; then
    failed="$failed $aur"
  fi
elif command -v apt-get >/dev/null; then
  export DEBIAN_FRONTEND=noninteractive
  $sudo apt-get update
  for p in $apt; do install "$p" $sudo apt-get install -y; done
elif command -v nix >/dev/null; then
  for p in $pkg $nix; do
    install "nixpkgs#$p" nix --extra-experimental-features "nix-command flakes" profile install
  done
else
  echo "No supported package manager found (brew, pacman, apt, nix). Skipping packages." >&2
fi

if [ -n "$failed" ]; then
  echo "Not installed:$failed" >&2
fi
