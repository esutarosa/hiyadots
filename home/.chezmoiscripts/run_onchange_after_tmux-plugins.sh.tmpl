{{- $selected := list -}}
{{- range .picks -}}{{- $selected = concat $selected . -}}{{- end -}}
{{- if has "tmux" $selected -}}
#!/bin/sh
# tmux.conf hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
plugins="$HOME/.config/tmux/plugins"
sed -n "s/^set -g @plugin '\(.*\)'$/\1/p" "$HOME/.config/tmux/tmux.conf" | while read -r plugin; do
  dir="$plugins/${plugin##*/}"
  [ -d "$dir" ] || git clone --depth 1 "https://github.com/$plugin" "$dir" || echo "Not installed: $plugin" >&2
done
{{ end -}}
